# 이 파일은 값이 비어있는 템플릿입니다. 실제 값은 .env.local 에만 넣으세요.
# .env.local 은 깃에 올라가지 않습니다.

# Anthropic API 키 (console.anthropic.com 에서 발급)
ANTHROPIC_API_KEY=

# 로그인 — 세 개를 모두 채우면 로그인 화면이 켜집니다.
# 하나라도 비어 있으면 로그인 없이 열립니다(로컬에서만 쓸 때).
APP_USER=
# 비밀번호에 #, 공백, 따옴표가 들어가면 반드시 큰따옴표로 감싸세요.
# 안 감싸면 # 뒤가 주석으로 잘려서 다른 비밀번호가 됩니다.  예) APP_PASSWORD="abc123##"
APP_PASSWORD=
# 세션 서명용 임의 문자열. 아래 명령으로 만들 수 있습니다.
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=
