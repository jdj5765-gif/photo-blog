# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
# 값이 비어있는 템플릿은 커밋합니다. 실제 키가 든 .env.local은 계속 제외됩니다.
!.env.example

# vercel
.vercel

# 작업 도구가 만드는 임시 기록
.omc/

# typescript
*.tsbuildinfo
next-env.d.ts

.vercel
.env*
